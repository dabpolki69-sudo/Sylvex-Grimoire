sylvex 0.3

profile creature_base {
  material: pbr
  motion: natural
  topology: optimised
}

creature "Sol-Stalker" @creature_base {
  height: 2.4m
  origin: vec3(0, 0, 0)
  accent: color("#00E5FF")
  scale: range(0.85, 1.15)
  rig: link("rig", "rigs/sol_stalker")
  locomotion: link("animation", "animations/stalker_locomotion")
  verify: anatomy+rig+animation
}
